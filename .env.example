# Copy to .env and export these into the process environment before starting
# the API. The server reads the variables below and does not open this file.
#
# PostgreSQL URL passed unchanged to GORM. Percent-encode reserved characters
# in the user or password (@ is %40, # is %23, % is %25).
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/test

# HS256 key used to sign and verify login tokens. Use a long random value.
JWT_SECRET=change-me
